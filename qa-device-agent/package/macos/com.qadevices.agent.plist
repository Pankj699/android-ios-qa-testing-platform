<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.qadevices.agent</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Applications/QA Device Agent.app/Contents/MacOS/qa-device-agent</string>
        <string>start</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>StandardOutPath</key>
    <string>~/Library/Logs/QA-Device-Agent/stdout.log</string>
    <key>StandardErrorPath</key>
    <string>~/Library/Logs/QA-Device-Agent/stderr.log</string>
</dict>
</plist>
