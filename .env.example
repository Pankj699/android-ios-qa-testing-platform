# ==============================================================================
# QA Testing Platform — Environment Configuration Template
# Copy this file to .env and configure for your deployment environment.
# NEVER commit the actual .env file or sensitive production credentials to git.
# ==============================================================================

# Server Configuration
PORT=8080
HTTP_PORT=8081
NODE_ENV=production
USE_HTTPS=true
CORS_ORIGIN=*

# PostgreSQL Database (Production Contract)
# Connection string format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/qa_testing_platform

# Cryptographic Secrets
# Provide cryptographically strong, unique secrets (minimum 32 random characters)
JWT_SECRET=replace_with_a_secure_random_string_min_32_characters_for_jwt
SESSION_SECRET=replace_with_a_secure_random_string_min_32_characters_for_sessions

# Initial Admin User Bootstrapping
# Configured only once on initial database bootstrap. Normal user registrations receive role=TESTER.
INITIAL_ADMIN_EMAIL=admin@qatools.internal
INITIAL_ADMIN_PASSWORD=replace_with_secure_initial_admin_password_123

# Tool Executable Paths (Optional: defaults to system PATH)
# ADB_PATH=adb
# JAVA_PATH=java
# PYTHON_PATH=python

# Storage and Limits
# UPLOAD_DIR=./uploads
# DATA_DIR=./data
# MAX_AAB_SIZE_MB=1024
# MAX_RECORDING_SIZE_MB=500
# TEST_TIMEOUT_MS=600000
# DEVICE_LOCK_TIMEOUT_MS=300000

# Google Drive & OAuth Integration (Phase 1+)
# Obtain credentials from Google Cloud Console (OAuth 2.0 Client ID)
GOOGLE_CLIENT_ID=replace_with_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace_with_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8080/api/drive/callback
# 32-byte hex or secret for AES-256-GCM encryption of stored Google OAuth access & refresh tokens
GOOGLE_TOKEN_ENCRYPTION_KEY=replace_with_secure_random_64_hex_chars_or_32_byte_key

