{
  "name": "android-pad-qa-platform",
  "version": "1.1.2",
  "description": "Production-ready Web-Based Android QA Testing Platform for Play Asset Delivery (PAD) & On-Demand Resources (ORD)",
  "private": true,
  "scripts": {
    "install:all": "npm.cmd install && cd backend && npm.cmd install && cd ../frontend && npm.cmd install",
    "dev:backend": "cd backend && npm.cmd run dev",
    "dev:frontend": "cd frontend && npm.cmd run dev",
    "dev": "concurrently \"npm.cmd run dev:backend\" \"npm.cmd run dev:frontend\"",
    "build:frontend": "cd frontend && npm.cmd run build",
    "start": "cd backend && npm.cmd start",
    "test": "cd backend && npm.cmd test",
    "version:get": "node scripts/version-manager.js get",
    "version:check": "node scripts/version-manager.js check",
    "version:sync": "node scripts/version-manager.js sync",
    "version:minor": "node scripts/version-manager.js bump minor",
    "version:major": "node scripts/version-manager.js bump major",
    "version:patch": "node scripts/version-manager.js bump patch"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "android",
    "play-asset-delivery",
    "pad",
    "ord",
    "bundletool",
    "adb",
    "qa-testing"
  ],
  "author": "QA Automation Team",
  "license": "MIT"
}
